<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Logic\Logic.csproj" />
    <ProjectReference Include="..\Models\Models.csproj" />
    <ProjectReference Include="..\Data_Mock\Data_Mock.csproj" />
    <ProjectReference Include="..\Data_Sqlite\Data_Sqlite.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <GitVersion Condition="'$(GitVersion)' == ''">Unknown</GitVersion>
    <GitSha />
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="GitVersion" Value="$(GitVersion)" />
    <AssemblyMetadata Include="GitSha" Value="$(GitSha)" />
  </ItemGroup>

  <Target Name="CopyPluginsToOutput" AfterTargets="Build;Publish">
    <PropertyGroup>
      <_CopyTargetDir Condition="'$(_CopyTargetDir)' == '' AND '$(PublishDir)' != ''">$(PublishDir)</_CopyTargetDir>
      <_CopyTargetDir Condition="'$(_CopyTargetDir)' == ''">$(OutputPath)</_CopyTargetDir>
    </PropertyGroup>

    <ItemGroup>
      <PluginFiles Include="Plugins\**\*.*" />
      <ThemeFiles Include="Themes\**\*.*" />
      <LanguageFiles Include="Languages\**\*.*" />
      <PackageFolder Include="..\com.nexx.unityhublink\**\*.*" />
    </ItemGroup>

    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(_CopyTargetDir)Plugins\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ThemeFiles)" DestinationFolder="$(_CopyTargetDir)Themes\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(LanguageFiles)" DestinationFolder="$(_CopyTargetDir)Languages\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PackageFolder)" DestinationFolder="$(_CopyTargetDir)com.nexx.unityhublink\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <PropertyGroup>
    <ApplicationIcon>./Assets/icon.ico</ApplicationIcon>
  </PropertyGroup>
</Project>