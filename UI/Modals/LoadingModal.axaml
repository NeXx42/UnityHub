<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" x:Class="UI.Modals.LoadingModal"
             xmlns:controls="clr-namespace:UI.Controls" x:Name="root">
  <Border Background="{DynamicResource BackgroundColourDark}" BorderThickness="1" BorderBrush="{DynamicResource ButtonBorder}" CornerRadius="{DynamicResource CornerRadius_Menu}" MinWidth="250">
    <Grid RowDefinitions="Auto * Auto" Margin="10">
      <Label Content="{Binding #root.header}" FontSize="16" Grid.Row="0" HorizontalAlignment="Center"/>
      <Grid Grid.Row="1" Margin="0 10">
        <TextBlock Text="{Binding #root.msg}" FontSize="12" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding #root.percentage}" FontSize="12" HorizontalAlignment="Right" />
      </Grid>
      <ProgressBar x:Name="inp_Progress" Grid.Row="2"/>
    </Grid>
  </Border>
</UserControl>
