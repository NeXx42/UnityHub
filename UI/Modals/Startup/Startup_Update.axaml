<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:controls="using:UI.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UnityHub.UI.Modals.Startup.Startup_Update">
  <StackPanel Spacing="5">
    <Label HorizontalAlignment="Center" FontSize="20" Content="{DynamicResource LANG_UpdateModal_Title}"/>

    <Label HorizontalAlignment="Center" x:Name="lbl_UpdateMessage">
      New update available
    </Label>

    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right">
      <controls:ButtonWrapper Margin="0 10 0 0" HorizontalAlignment="Right" Label="Ignore" Width="150" HorizontalContentAlignment="Center" x:Name="btn_Ignore"/>
      <controls:ButtonWrapper Margin="0 10 0 0" Classes="Primary" HorizontalAlignment="Right" Label="Update" Width="150" HorizontalContentAlignment="Center" x:Name="btn_Update"/>
    </StackPanel>
  </StackPanel>
</UserControl>
