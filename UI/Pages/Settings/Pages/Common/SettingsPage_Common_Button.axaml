<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:controls="using:UI.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UI.Pages.Settings.Pages.Common.SettingsPage_Common_Button" x:Name="root">
  <Grid ColumnDefinitions="* 5 200">
    <Label Content="{Binding #root.Label}" />
    <controls:ButtonWrapper Label="{Binding #root.ButtonText}" x:Name="btn" Classes="Primary" Grid.Column="2" HorizontalContentAlignment="Center"/>
  </Grid>
</UserControl>
