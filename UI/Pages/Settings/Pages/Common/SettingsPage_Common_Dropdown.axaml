<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" x:Class="UI.Pages.Settings.Pages.Common.SettingsPage_Common_Dropdown" x:Name="root">
  <Grid ColumnDefinitions="Auto * 200">
    <Label Content="{Binding #root.Label}"/>
    <ComboBox Grid.Column="3" x:Name="inp_Options"></ComboBox>
  </Grid>
</UserControl>
