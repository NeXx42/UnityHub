<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:controls="using:UI.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UnityHub.UI.Pages.Settings.Pages.SettingsPage_Plugins_Item" xmlns:models="clr-namespace:Models.Data;assembly=Models" x:DataType="models:PluginManifest">
  <Border x:Name="cont">
    <Border.Styles>
      <Style Selector="Border.Odd">
        <Setter Property="Background" Value="{DynamicResource BackgroundColourLight}"/>
      </Style>
    </Border.Styles>

    <Grid ColumnDefinitions="Auto Auto * Auto 5 Auto" Margin="5">
      <Label VerticalAlignment="Center" Content="{Binding Name}" Margin="0 0 5 0"/>
      <controls:ButtonWrapper VerticalAlignment="Center" Grid.Column="6" x:Name="btn_Settings"  Label="Settings" />
    </Grid>
  </Border>
</UserControl>
