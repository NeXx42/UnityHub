    <sys:String x:Key="LANG_Settings_General_Language">Language</sys:String>
    <sys:String x:Key="LANG_Settings_Themes_Header">Themes</sys:String>


    <!-- Literals -->    
    <sys:String x:Key="LANG_Literal_Collections">Collections</sys:String>
    <sys:String x:Key="LANG_Literal_Tags">Tags</sys:String>
    <sys:String x:Key="LANG_Literal_Projects">Projects</sys:String>
    <sys:String x:Key="LANG_Literal_Project">Project</sys:String>
    <sys:String x:Key="LANG_Literal_Cancel">Cancel</sys:String>
    <sys:String x:Key="LANG_Literal_Editors">Editors</sys:String>
    <sys:String x:Key="LANG_Literal_Editor">Editor</sys:String>
    <sys:String x:Key="LANG_Literal_Save">Save</sys:String>
    <sys:String x:Key="LANG_Literal_Edit">Edit</sys:String>
