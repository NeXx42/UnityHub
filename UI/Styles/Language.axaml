    <sys:String x:Key="LANG_HomePage_SideBar_Recent">Faviourte</sys:String>
    <sys:String x:Key="LANG_HomePage_SearchBarPlaceholder">Search Projects</sys:String>
    <sys:String x:Key="LANG_HomePage_CreateProject">Create Project</sys:String>

    <!-- Import modal-->    
    <sys:String x:Key="LANG_ProjectImport_Title">Import</sys:String>
    <sys:String x:Key="LANG_ProjectImport_Btn">Import</sys:String>

    <!-- Settings page -->    
    <sys:String x:Key="LANG_Settings_Sidebar_Editor">Editor</sys:String>
